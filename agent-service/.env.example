MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/chronicle?appName=ChronicleCluster
GEMINI_API_KEY=your_primary_gemini_key_here
GEMINI_API_KEY_SECONDARY=your_secondary_gemini_key_here
PORT=8000
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Vector Database Configuration ---
# 1. Pinecone Serverless (Recommended for Production & Cloud Hosting)
# Sign up at https://app.pinecone.io/ (Instant signup, free tier: 100k vectors)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=chronicle
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# 2. ChromaDB (Local / Development Fallback)
# Used automatically if PINECONE_API_KEY is not set.
# Stores persistent vector files locally in ./chroma_data.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=default_database
