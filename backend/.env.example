PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/chronicle?appName=ChronicleCluster
GITHUB_TOKEN=your_github_pat_token_here
AGENT_SERVICE_URL=https://chronicle-agent-service.onrender.com

# --- GitHub OAuth 2.0 Configuration ---
# Register at: https://github.com/settings/developers > OAuth Apps > New OAuth App
# Homepage URL: http://localhost:3000 (or https://chronicle-r4pj.vercel.app for prod)
# Authorization callback URL: http://localhost:5000/auth/github/callback (or https://chronicle-backend-service.onrender.com/auth/github/callback for prod)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
FRONTEND_URL=http://localhost:3000
# Optional: explicitly set callback url if behind custom domain/proxy
REDIRECT_URI=http://localhost:5000/auth/github/callback
